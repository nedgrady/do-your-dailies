# Local dev — copy to .env (gitignored) and adjust if needed.
# Required. No default — the app fails fast if this is unset.
DATABASE_URL=host=localhost user=postgres password=postgres dbname=dailies port=5432 sslmode=disable

# Set to 'true' to honor the X-Simulated-User-Id header (impersonation, for
# the admin cold-start simulator). Off unless set. Leave unset in production.
SIMULATION_MODE_ENABLED=
