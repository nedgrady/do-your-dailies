# URL of the Go backend API.
# For local dev set this in .env.local (gitignored) — never commit real values here.
# Example: VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=

# Set to 'true' to enable the in-app developer tools panel. Leave unset in production.
VITE_ENABLE_DEVTOOLS=

# Set to 'true' to enable the admin-only cold-start simulator page
# (/admin/simulator). Only does anything if the server also has
# SIMULATION_MODE_ENABLED set. Leave unset in production.
VITE_ENABLE_SIMULATOR=